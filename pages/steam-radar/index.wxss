.steam-page { padding-top: calc(42rpx + env(safe-area-inset-top)); padding-bottom: 64rpx; }.steam-hero,.status-head,.type-picker,.list-head,.record-row,.record-actions,.plan-step { display: flex; flex-direction: row; }.steam-hero { align-items: center; }.steam-mark { display: flex; flex: none; flex-direction: row; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin-right: 22rpx; border-radius: 24rpx; background: linear-gradient(145deg,#183b5b,#2f79b8); color: #fff; font-size: 32rpx; font-weight: 900; box-shadow: 0 12rpx 26rpx rgba(30,79,119,.22); }.steam-copy { min-width: 0; }.steam-title { font-size: 39rpx; font-weight: 800; line-height: 1.2; }.steam-subtitle { margin-top: 6rpx; color: #71807b; font-size: 23rpx; line-height: 1.45; }
.status-card { margin-top: 28rpx; padding: 24rpx; border-radius: 25rpx; background: linear-gradient(145deg,#eaf4fc,#f7fbfe); border: 1rpx solid #b9d7ee; }.status-head { align-items: center; justify-content: space-between; }.status-kicker { color: #4b7394; font-size: 20rpx; font-weight: 700; }.status-title { margin-top: 3rpx; color: #173f61; font-size: 28rpx; font-weight: 850; }.status-count { padding: 10rpx 14rpx; border-radius: 16rpx; background: #2d75ae; color: #fff; font-size: 20rpx; font-weight: 750; }.status-copy { margin-top: 16rpx; color: #5f7586; font-size: 21rpx; line-height: 1.6; }
.add-card { margin-top: 22rpx; padding: 26rpx 24rpx; border: 1rpx solid #d8e1dd; border-radius: 27rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(18,33,41,.05); }.add-title { margin-bottom: 22rpx; font-size: 28rpx; font-weight: 850; }.field-label { color: #64736d; font-size: 22rpx; font-weight: 700; }.field-label--spaced { margin-top: 22rpx; }.name-input,.type-picker { min-height: 86rpx; margin-top: 9rpx; padding: 0 19rpx; border: 1rpx solid #d1dad6; border-radius: 19rpx; background: #f9fbfa; color: #21312b; font-size: 25rpx; }.name-input { height: 86rpx; }.type-picker { align-items: center; justify-content: space-between; }.type-picker--empty { color: #929c98; }.picker-arrow { width: 14rpx; height: 14rpx; border-right: 3rpx solid #87938f; border-bottom: 3rpx solid #87938f; transform: rotate(45deg) translateY(-4rpx); }.add-button { margin-top: 25rpx; min-height: 88rpx; border-radius: 21rpx; background: #286fa9; color: #fff; font-size: 26rpx; font-weight: 800; }
.list-head { align-items: center; justify-content: space-between; margin-top: 30rpx; }.list-title { font-size: 29rpx; font-weight: 850; }.list-tip { color: #899490; font-size: 20rpx; }.records-card { margin-top: 12rpx; overflow: hidden; border: 1rpx solid #d8e1dd; border-radius: 25rpx; background: #fff; }.record-row { align-items: center; min-height: 118rpx; padding: 18rpx 20rpx; }.record-row + .record-row { border-top: 1rpx solid #ebefed; }.record-row--expired { opacity: .55; }.record-row--claimed { background: #f5f8f7; }.type-badge { display: flex; flex: none; flex-direction: row; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin-right: 16rpx; border-radius: 19rpx; background: #e6f2fb; color: #2c6e9f; font-size: 19rpx; font-weight: 850; }.record-main { flex: 1; min-width: 0; }.record-name { overflow: hidden; font-size: 24rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }.record-meta { margin-top: 5rpx; color: #74837d; font-size: 20rpx; }.record-actions { flex: none; align-items: center; margin-left: 10rpx; }.copy-action,.claim-action { margin: 0; padding: 10rpx 8rpx; background: transparent; font-size: 19rpx; }.copy-action { color: #6d7c77; }.claim-action { color: #286fa9; font-weight: 750; }.claim-action--done { color: #55866f; }
.empty-card { margin-top: 24rpx; padding: 44rpx 28rpx; border: 2rpx dashed #cad8e2; border-radius: 25rpx; background: #f5faff; text-align: center; }.empty-mark { display: flex; flex-direction: row; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin: 0 auto; border-radius: 22rpx; background: #dceefa; color: #2c73aa; font-size: 38rpx; }.empty-title { margin-top: 16rpx; font-size: 25rpx; font-weight: 800; }.empty-copy { margin-top: 7rpx; color: #74847d; font-size: 21rpx; line-height: 1.6; }.plan-card { margin-top: 24rpx; padding: 25rpx 23rpx; border-radius: 25rpx; background: #172f43; color: #fff; }.plan-title { margin-bottom: 17rpx; font-size: 26rpx; font-weight: 850; }.plan-step { align-items: flex-start; margin-top: 13rpx; color: #dce8f1; font-size: 21rpx; line-height: 1.55; }.plan-step text { display: flex; flex: none; flex-direction: row; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; margin-right: 13rpx; border-radius: 12rpx; background: #367eae; color: #fff; font-size: 18rpx; font-weight: 850; }.plan-step view { flex: 1; }.steam-note { padding: 25rpx 10rpx 0; color: #7d8a86; font-size: 20rpx; line-height: 1.6; text-align: center; }
