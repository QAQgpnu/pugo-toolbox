.page-heading {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.heading-mark {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  background: #fff4df;
  color: #ae6900;
  font-size: 30rpx;
  font-weight: 800;
}

.heading-title {
  color: #122129;
  font-size: 38rpx;
  font-weight: 800;
}

.field-label {
  color: #4a5a54;
  font-size: 24rpx;
  font-weight: 700;
}

.field-placeholder { color: #9aa6a1; }

.result-label {
  color: #4a5a54;
  font-size: 24rpx;
  font-weight: 700;
}

.wizard-card {
  margin-top: 28rpx;
  padding: 26rpx 24rpx 28rpx;
}

.wizard-head { margin-bottom: 6rpx; }

.wizard-title {
  color: #122129;
  font-size: 30rpx;
  font-weight: 800;
}

.wizard-scenarios {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 16rpx;
  margin-right: -8rpx;
  margin-left: -8rpx;
}

.wizard-scenario-cell {
  width: 50%;
  min-width: 0;
  padding: 8rpx;
}

.wizard-scenario {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  padding: 14rpx 16rpx;
  border: 1rpx solid #d7e0dd;
  border-radius: 18rpx;
  background: #ffffff;
}

.wizard-scenario-name {
  color: #122129;
  font-size: 25rpx;
  font-weight: 750;
}

.wizard-scenario-desc {
  margin-top: 4rpx;
  color: #85918c;
  font-size: 20rpx;
  line-height: 1.4;
}

.wizard-scenario--active {
  border-color: #078c82;
  background: #e8f7f4;
}

.chip-pressed { opacity: 0.78; }

.wizard-form { margin-top: 20rpx; }

.wizard-field { margin-top: 16rpx; }

.wizard-input {
  width: 100%;
  height: 78rpx;
  margin-top: 8rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d7e0dd;
  border-radius: 16rpx;
  background: #fbfdfc;
  color: #122129;
  font-size: 26rpx;
}

.wizard-actions {
  display: flex;
  flex-direction: row;
  margin-top: 20rpx;
  margin-right: -8rpx;
  margin-left: -8rpx;
}

.wizard-action {
  flex: 1;
  margin: 0 8rpx;
  min-height: 76rpx;
  font-size: 26rpx;
}

.wizard-generate { margin-top: 18rpx; }

.wizard-result {
  margin-top: 22rpx;
  padding: 20rpx;
  border: 1rpx solid #bfe6df;
  border-radius: 18rpx;
  background: #f4fbf9;
}

.wizard-formula-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 10rpx;
}

.wizard-formula {
  flex: 1;
  min-width: 0;
  color: #0b5d56;
  font-size: 26rpx;
  font-weight: 700;
  word-break: break-all;
}

.copy-chip {
  flex: none;
  margin-left: 14rpx;
  padding: 10rpx 20rpx;
  border-radius: 14rpx;
  background: #078c82;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.wizard-explain {
  margin-top: 12rpx;
  color: #4a5a54;
  font-size: 23rpx;
  line-height: 1.6;
}

.search-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 84rpx;
  margin-top: 26rpx;
  padding: 0 20rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  color: #122129;
  font-size: 26rpx;
}

.search-clear {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  color: #687772;
  font-size: 34rpx;
}

.formula-category-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.formula-category-strip {
  display: inline-flex;
  flex-direction: row;
  padding-right: 24rpx;
}

.formula-category-chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid #d4ddda;
  border-radius: 999rpx;
  background: #ffffff;
  color: #66756f;
  font-size: 23rpx;
  font-weight: 650;
}

.formula-category-chip + .formula-category-chip { margin-left: 12rpx; }

.formula-category-chip--active {
  border-color: #078c82;
  background: #078c82;
  color: #ffffff;
}

.formula-category-count {
  margin-left: 8rpx;
  opacity: 0.72;
  font-size: 19rpx;
}

.recent-formulas {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 22rpx;
}

.recent-formulas-label {
  flex: none;
  color: #8a9692;
  font-size: 22rpx;
}

.recent-formulas-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.recent-formulas-strip {
  display: inline-flex;
  flex-direction: row;
}

.recent-formula-chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 52rpx;
  margin-left: 12rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #edf2f0;
  color: #4a5a54;
  font-size: 21rpx;
  font-weight: 650;
}

.formula-list { margin-top: 22rpx; }

.formula-card { margin-top: 16rpx; }

.formula-card:first-child { margin-top: 0; }

.formula-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 24rpx;
  transition: opacity 120ms ease;
}

.formula-head--pressed { opacity: 0.72; }

.formula-head-main {
  flex: 1;
  min-width: 0;
}

.formula-name {
  color: #122129;
  font-size: 29rpx;
  font-weight: 800;
}

.formula-usage {
  margin-top: 5rpx;
  color: #71807b;
  font-size: 23rpx;
  line-height: 1.45;
}

.formula-star {
  flex: none;
  margin-left: 12rpx;
  padding: 8rpx 12rpx;
  color: #a3ada9;
  font-size: 36rpx;
}

.formula-star--active { color: #dc8600; }

.formula-detail {
  border-top: 1rpx solid #e7ecea;
  padding: 20rpx 24rpx 24rpx;
  background: #fbfdfc;
}

.formula-block { margin-top: 14rpx; }

.formula-block:first-child { margin-top: 0; }

.formula-block-label {
  color: #4a5a54;
  font-size: 22rpx;
  font-weight: 750;
}

.formula-code {
  display: block;
  margin-top: 8rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #eef4f2;
  color: #0b5d56;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.formula-example-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
}

.formula-example-row .formula-code {
  flex: 1;
  min-width: 0;
  margin-top: 0;
}

.formula-plain {
  margin-top: 8rpx;
  color: #4a5a54;
  font-size: 23rpx;
  line-height: 1.6;
}

.formula-plain--warn { color: #b46500; }

.privacy-note { margin-top: 30rpx; }
