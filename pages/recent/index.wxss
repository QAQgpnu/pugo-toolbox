.recent-page { padding-top: 34rpx; }

.recent-hero,
.section-heading-row,
.recent-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.recent-hero {
  padding: 26rpx;
  border: 1rpx solid #b9ddd8;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #e8f7f4, #ffffff);
}

.recent-hero-mark,
.recent-symbol {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background: #078c82;
  color: #ffffff;
  font-weight: 800;
}

.recent-hero-mark {
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 23rpx;
  font-size: 27rpx;
}

.recent-hero-main { min-width: 0; }

.recent-hero-title {
  color: #122129;
  font-size: 36rpx;
  font-weight: 800;
}

.recent-hero-desc {
  margin-top: 5rpx;
  color: #6e7d78;
  font-size: 23rpx;
}

.section-heading-row {
  justify-content: space-between;
  margin-top: 38rpx;
  margin-bottom: 18rpx;
}

.section-title--flush { margin-bottom: 0; }

.clear-action {
  min-height: 62rpx;
  padding: 17rpx 4rpx 15rpx 24rpx;
  color: #a96117;
  font-size: 23rpx;
  font-weight: 700;
}

.recent-row {
  min-height: 112rpx;
  padding: 18rpx 22rpx;
  transition: opacity 120ms ease, background-color 120ms ease;
}

.recent-row + .recent-row { border-top: 1rpx solid #e5ebe8; }

.recent-row--pressed {
  background: #f1f7f5;
  opacity: 0.8;
}

.recent-symbol {
  width: 66rpx;
  height: 66rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: #e8f7f4;
  color: #078c82;
  font-size: 23rpx;
}

.recent-name {
  color: #122129;
  font-size: 28rpx;
  font-weight: 700;
}

.recent-desc {
  margin-top: 5rpx;
  overflow: hidden;
  color: #71807b;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 430rpx;
  padding: 44rpx 28rpx;
  text-align: center;
}

.recent-empty-title {
  color: #122129;
  font-size: 29rpx;
  font-weight: 750;
}

.recent-empty-desc {
  margin-top: 8rpx;
  color: #7c8984;
  font-size: 23rpx;
}

.open-drawer-action {
  min-height: 76rpx;
  margin-top: 28rpx;
  padding: 20rpx 30rpx;
  border-radius: 19rpx;
  background: #078c82;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 750;
  transition: opacity 120ms ease, transform 120ms ease;
}

.open-drawer-action--pressed {
  opacity: 0.8;
  transform: scale(0.97);
}

.recent-note {
  margin-top: 24rpx;
  color: #8b9792;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}
