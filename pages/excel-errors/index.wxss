.page-heading {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.heading-mark {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  background: #fdeeee;
  color: #b3403a;
  font-size: 30rpx;
  font-weight: 800;
}

.heading-title {
  color: #122129;
  font-size: 38rpx;
  font-weight: 800;
}

.field-placeholder { color: #9aa6a1; }

.search-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 84rpx;
  margin-top: 26rpx;
  padding: 0 20rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  color: #122129;
  font-size: 26rpx;
}

.search-clear {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  color: #687772;
  font-size: 34rpx;
}

.error-category-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.error-category-strip {
  display: inline-flex;
  flex-direction: row;
  padding-right: 24rpx;
}

.error-category-chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid #d4ddda;
  border-radius: 999rpx;
  background: #ffffff;
  color: #66756f;
  font-size: 23rpx;
  font-weight: 650;
}

.error-category-chip + .error-category-chip { margin-left: 12rpx; }

.error-category-chip--active {
  border-color: #078c82;
  background: #078c82;
  color: #ffffff;
}

.error-category-count {
  margin-left: 8rpx;
  opacity: 0.72;
  font-size: 19rpx;
}

.error-list { margin-top: 22rpx; }

.error-card { margin-top: 16rpx; }

.error-card:first-child { margin-top: 0; }

.error-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 24rpx;
  transition: opacity 120ms ease;
}

.error-head--pressed { opacity: 0.72; }

.error-code {
  flex: none;
  margin-right: 18rpx;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.error-code--red {
  background: #fdeeee;
  color: #b3403a;
}

.error-code--amber {
  background: #fff3dc;
  color: #b46500;
}

.error-head-main {
  flex: 1;
  min-width: 0;
}

.error-title {
  color: #122129;
  font-size: 28rpx;
  font-weight: 800;
}

.error-summary {
  margin-top: 5rpx;
  color: #71807b;
  font-size: 23rpx;
  line-height: 1.45;
}

.error-detail {
  border-top: 1rpx solid #e7ecea;
  padding: 20rpx 24rpx 24rpx;
  background: #fbfdfc;
}

.error-sample {
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #eef4f2;
  color: #4a5a54;
  font-size: 23rpx;
  line-height: 1.55;
}

.error-block { margin-top: 18rpx; }

.error-block-label {
  color: #4a5a54;
  font-size: 22rpx;
  font-weight: 750;
}

.error-item {
  margin-top: 8rpx;
  color: #4a5a54;
  font-size: 23rpx;
  line-height: 1.6;
}

.error-item--step {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.error-item--warn { color: #b46500; }

.error-step-index {
  flex: none;
  margin-right: 8rpx;
  color: #0b5d56;
  font-weight: 750;
}

.error-step-text {
  flex: 1;
  min-width: 0;
}

.error-fix {
  display: block;
  margin-top: 8rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #eef4f2;
  color: #0b5d56;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.privacy-note { margin-top: 30rpx; }
