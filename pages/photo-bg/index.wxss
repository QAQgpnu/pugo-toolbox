.photo-page { padding-top: calc(42rpx + env(safe-area-inset-top)); padding-bottom: 64rpx; }
.photo-hero { display: flex; flex-direction: row; align-items: center; }
.photo-mark { display: flex; flex: none; flex-direction: row; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin-right: 22rpx; border-radius: 24rpx; background: linear-gradient(145deg,#438edb,#7bb5ed); color: #fff; font-size: 30rpx; font-weight: 850; box-shadow: 0 12rpx 26rpx rgba(67,142,219,.2); }
.photo-copy { min-width: 0; }.photo-title { color: #122129; font-size: 39rpx; font-weight: 800; line-height: 1.2; }.photo-subtitle { margin-top: 6rpx; color: #71807b; font-size: 23rpx; line-height: 1.45; }
.scope-note { margin-top: 28rpx; padding: 20rpx 22rpx; border-left: 7rpx solid #d89127; border-radius: 8rpx 20rpx 20rpx 8rpx; background: #fff6e6; }.scope-title { color: #915900; font-size: 23rpx; font-weight: 800; }.scope-copy { margin-top: 6rpx; color: #806947; font-size: 21rpx; line-height: 1.6; }
.photo-stage { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 650rpx; margin-top: 24rpx; overflow: hidden; border: 1rpx solid #d8e1dd; border-radius: 30rpx; background: linear-gradient(135deg,#f6f8f7,#e8efec); box-shadow: 0 14rpx 34rpx rgba(18,33,41,.06); }
.photo-stage--disabled { opacity: .84; }
.photo-preview { display: block; width: 100%; height: 650rpx; }.photo-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40rpx; text-align: center; }.empty-icon { display: flex; flex-direction: row; align-items: center; justify-content: center; width: 94rpx; height: 94rpx; border: 2rpx dashed #72a8d6; border-radius: 30rpx; background: rgba(255,255,255,.86); color: #3179b7; font-size: 46rpx; }.empty-title { margin-top: 22rpx; font-size: 29rpx; font-weight: 800; }.empty-copy { margin-top: 8rpx; color: #71807b; font-size: 22rpx; }
.processing-mask { position: absolute; right: 0; bottom: 0; left: 0; padding: 22rpx; background: rgba(18,33,41,.78); color: #fff; font-size: 23rpx; font-weight: 700; text-align: center; }
.change-photo { margin: 16rpx auto 0; padding: 12rpx 24rpx; background: transparent; color: #3179b7; font-size: 22rpx; font-weight: 700; }
.change-photo[disabled],.color-option[disabled],.size-option[disabled],.secondary-button[disabled],.primary-button-photo[disabled] { opacity: .56; }
.control-card { margin-top: 18rpx; padding: 26rpx 22rpx; border: 1rpx solid #d8e1dd; border-radius: 27rpx; background: #fff; }.control-label { color: #4b5c56; font-size: 23rpx; font-weight: 750; }.control-label--spaced { margin-top: 28rpx; }
.color-row,.action-row { display: flex; flex-direction: row; }.color-row { flex-wrap: wrap; margin: 10rpx -5rpx -2rpx; }.color-option { display: flex; flex: 1; flex-direction: row; align-items: center; justify-content: center; min-width: 145rpx; min-height: 72rpx; margin: 5rpx; padding: 12rpx; border: 1rpx solid #d8e1dd; border-radius: 18rpx; background: #f8faf9; color: #5f6e69; font-size: 22rpx; }.color-option--active { border: 3rpx solid #438edb; background: #eef6fd; color: #226ba9; font-weight: 750; }.color-dot { width: 28rpx; height: 28rpx; margin-right: 10rpx; border: 1rpx solid #c9d1ce; border-radius: 50%; }
.size-scroll { display: flex; flex-direction: row; width: 100%; margin-top: 12rpx; white-space: nowrap; }.size-option { display: inline-flex; flex-direction: column; align-items: flex-start; justify-content: center; width: 218rpx; min-height: 128rpx; margin-right: 12rpx; padding: 16rpx; border: 1rpx solid #d8e1dd; border-radius: 18rpx; background: #f8faf9; text-align: left; }.size-option--active { border: 3rpx solid #438edb; background: #eef6fd; }.size-name { color: #26342f; font-size: 23rpx; font-weight: 800; }.size-mm { margin-top: 5rpx; color: #60706a; font-size: 19rpx; }.size-px { margin-top: 3rpx; color: #87918d; font-size: 18rpx; }.size-help { margin-top: 16rpx; color: #84908c; font-size: 20rpx; line-height: 1.55; }
.action-row { margin-top: 22rpx; }.secondary-button,.primary-button-photo { flex: 1; min-height: 88rpx; border-radius: 21rpx; font-size: 25rpx; font-weight: 750; }.secondary-button { margin-right: 14rpx; border: 1rpx solid #72a8d6; background: #fff; color: #246da9; }.primary-button-photo { background: #438edb; color: #fff; }
.local-note { padding: 24rpx 10rpx 0; color: #7e8a86; font-size: 21rpx; line-height: 1.6; text-align: center; }.processor-canvas { position: fixed; top: 0; left: -10000px; opacity: 0; pointer-events: none; }.photo-pressed { opacity: .82; transform: scale(.99); }
