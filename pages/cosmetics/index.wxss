.cos-page { padding-top: calc(42rpx + env(safe-area-inset-top)); padding-bottom: 64rpx; }.cos-hero,.input-head,.example-row,.result-summary,.tab-row,.ingredient-row { display: flex; flex-direction: row; }.cos-hero { align-items: center; }.cos-mark { display: flex; flex: none; flex-direction: row; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin-right: 22rpx; border-radius: 24rpx; background: linear-gradient(145deg,#bd6d88,#e09ab0); color: #fff; font-size: 30rpx; font-weight: 850; box-shadow: 0 12rpx 26rpx rgba(189,109,136,.2); }.cos-copy { min-width: 0; }.cos-title { font-size: 39rpx; font-weight: 800; line-height: 1.2; }.cos-subtitle { margin-top: 6rpx; color: #71807b; font-size: 23rpx; }
.science-note { margin-top: 28rpx; padding: 20rpx 22rpx; border-radius: 22rpx; background: #fff0f4; color: #754355; }.science-title { font-size: 23rpx; font-weight: 800; }.science-copy { margin-top: 6rpx; font-size: 21rpx; line-height: 1.6; }.example-row { justify-content: space-between; margin-top: 16rpx; }.example-button,.clear-button { min-height: 66rpx; margin: 0; padding: 10rpx 20rpx; background: transparent; font-size: 22rpx; font-weight: 700; }.example-button { color: #ad5876; }.clear-button { color: #7e8a86; }
.input-card { margin-top: 14rpx; overflow: hidden; border: 1rpx solid #e2d6da; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(54,35,42,.04); }.input-card--a { border-top: 7rpx solid #bd6d88; }.input-card--b { border-top: 7rpx solid #5a8fad; }.input-head { align-items: center; padding: 22rpx 22rpx 12rpx; }.input-badge { display: flex; flex: none; flex-direction: row; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; margin-right: 15rpx; border-radius: 17rpx; background: #f7dfe7; color: #9c4c68; font-size: 24rpx; font-weight: 850; }.input-badge--b { background: #e2f0f6; color: #477e9d; }.input-title { font-size: 25rpx; font-weight: 800; }.input-help { margin-top: 3rpx; color: #89938f; font-size: 20rpx; }.ingredient-input { width: 100%; min-height: 188rpx; padding: 12rpx 22rpx; color: #26342f; font-size: 25rpx; line-height: 1.65; }.input-count { padding: 0 22rpx 18rpx; color: #9aa39f; font-size: 19rpx; text-align: right; }
.compare-button { margin-top: 22rpx; min-height: 90rpx; border-radius: 22rpx; background: #aa5873; color: #fff; font-size: 27rpx; font-weight: 800; box-shadow: 0 12rpx 26rpx rgba(170,88,115,.18); }.result-wrap { margin-top: 28rpx; }.result-summary { align-items: center; padding: 24rpx 8rpx; border-radius: 25rpx; background: linear-gradient(135deg,#fff2f6,#f4f8fa); }.summary-item { flex: 1; text-align: center; }.summary-number { color: #9f506c; font-size: 39rpx; font-weight: 900; }.summary-label { margin-top: 3rpx; color: #687570; font-size: 20rpx; }.summary-divider { width: 1rpx; height: 56rpx; background: #decfd4; }.unknown-tip { margin-top: 14rpx; padding: 16rpx 18rpx; border-radius: 16rpx; background: #fff7e9; color: #86602d; font-size: 20rpx; line-height: 1.5; }
.tab-row { margin-top: 20rpx; padding: 6rpx; border-radius: 19rpx; background: #edf1ef; }.tab-button { flex: 1; min-height: 68rpx; border-radius: 15rpx; background: transparent; color: #6e7a76; font-size: 22rpx; font-weight: 700; }.tab-button--active,.tab-button--active-a,.tab-button--active-b { background: #fff; box-shadow: 0 4rpx 14rpx rgba(18,33,41,.08); }.tab-button--active,.tab-button--active-a { color: #a65370; }.tab-button--active-b { color: #477e9d; }.ingredient-list { margin-top: 14rpx; overflow: hidden; border: 1rpx solid #dde4e1; border-radius: 24rpx; background: #fff; }.ingredient-row { align-items: center; min-height: 96rpx; padding: 18rpx 22rpx; }.ingredient-row + .ingredient-row { border-top: 1rpx solid #edf1ef; }.ingredient-main { flex: 1; min-width: 0; }.ingredient-name { font-size: 25rpx; font-weight: 750; }.ingredient-category { margin-top: 4rpx; color: #a05b73; font-size: 20rpx; }.ingredient-note { margin-top: 10rpx; padding: 13rpx 15rpx; border-radius: 14rpx; background: #f7f9f8; color: #64726d; font-size: 21rpx; line-height: 1.55; }.row-arrow { flex: none; width: 15rpx; height: 15rpx; margin-left: 18rpx; border-right: 3rpx solid #8b9692; border-bottom: 3rpx solid #8b9692; transform: rotate(45deg) translateY(-4rpx); }.row-arrow--open { transform: rotate(225deg) translate(-2rpx,-2rpx); }.empty-result { margin-top: 14rpx; padding: 42rpx; border-radius: 22rpx; background: #f2f5f3; color: #88938f; text-align: center; }.source-note { padding: 28rpx 10rpx 0; color: #7e8a86; font-size: 20rpx; line-height: 1.65; text-align: center; }
.ocr-status { margin-top: 14rpx; padding: 14rpx 17rpx; border-radius: 16rpx; background: #f3f5f4; color: #77837f; font-size: 20rpx; line-height: 1.5; }.ocr-status--ready { background: #eaf7f1; color: #33745a; }.input-heading { flex: 1; min-width: 0; }.ocr-button { flex: none; min-height: 62rpx; margin: 0 0 0 12rpx; padding: 10rpx 15rpx; border-radius: 16rpx; background: #f7dfe7; color: #9c4c68; font-size: 20rpx; font-weight: 750; }.ocr-button--b { background: #e2f0f6; color: #477e9d; }.ocr-button[disabled] { opacity: .48; }.ocr-canvas { position: fixed; top: 0; left: -10000px; width: 2px; height: 2px; opacity: 0; pointer-events: none; }
