.period-page { padding-top: calc(42rpx + env(safe-area-inset-top)); padding-bottom: 64rpx; }.period-hero,.estimate-head,.metrics-row,.records-head,.record-row,.duration-line,.fallback-field { display: flex; flex-direction: row; }.period-hero { align-items: center; }.period-mark { display: flex; flex: none; flex-direction: row; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin-right: 22rpx; border-radius: 25rpx; background: linear-gradient(145deg,#b85e7d,#e395ad); color: #fff; font-size: 30rpx; font-weight: 850; box-shadow: 0 12rpx 26rpx rgba(184,94,125,.2); }.period-copy { min-width: 0; }.period-title { font-size: 39rpx; font-weight: 800; line-height: 1.2; }.period-subtitle { margin-top: 6rpx; color: #71807b; font-size: 23rpx; }
.privacy-card { margin-top: 28rpx; padding: 20rpx 22rpx; border-radius: 22rpx; background: #fff0f4; }.privacy-title { color: #934a63; font-size: 23rpx; font-weight: 800; }.privacy-copy { margin-top: 6rpx; color: #735964; font-size: 21rpx; line-height: 1.55; }.entry-card { margin-top: 22rpx; padding: 26rpx 24rpx; border: 1rpx solid #dedfdd; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(18,33,41,.05); }.entry-title { margin-bottom: 22rpx; font-size: 28rpx; font-weight: 800; }.field-label { color: #66736f; font-size: 22rpx; font-weight: 700; }.field-label--spaced { margin-top: 22rpx; }.date-picker { display: flex; flex-direction: row; align-items: center; justify-content: space-between; min-height: 88rpx; margin-top: 9rpx; padding: 18rpx 20rpx; border: 1rpx solid #d3dcd8; border-radius: 19rpx; background: #f9fbfa; color: #22312c; font-size: 26rpx; font-weight: 700; }.date-picker--empty { color: #929c98; font-weight: 500; }.picker-arrow { width: 14rpx; height: 14rpx; border-right: 3rpx solid #8a9692; border-bottom: 3rpx solid #8a9692; transform: rotate(45deg) translateY(-4rpx); }.duration-line { align-items: center; width: 210rpx; min-height: 84rpx; margin-top: 9rpx; padding: 0 18rpx; border: 1rpx solid #d3dcd8; border-radius: 19rpx; background: #f9fbfa; color: #65736e; font-size: 24rpx; }.duration-input { flex: 1; height: 80rpx; color: #22312c; font-size: 30rpx; font-weight: 800; }.add-button { margin-top: 25rpx; min-height: 88rpx; border-radius: 21rpx; background: #a65370; color: #fff; font-size: 26rpx; font-weight: 800; }
.estimate-card { margin-top: 22rpx; padding: 26rpx; border: 2rpx solid #d78da5; border-radius: 28rpx; background: linear-gradient(145deg,#fff4f7,#fff); }.estimate-head { align-items: flex-start; justify-content: space-between; }.estimate-kicker { color: #9b526a; font-size: 22rpx; font-weight: 750; }.estimate-date { margin-top: 6rpx; color: #6f3248; font-size: 42rpx; font-weight: 900; }.confidence-badge { padding: 10rpx 14rpx; border-radius: 15rpx; background: #f4dce4; color: #984e67; font-size: 19rpx; font-weight: 750; }.window-copy { margin-top: 14rpx; color: #705d64; font-size: 22rpx; }.metrics-row { align-items: center; margin-top: 24rpx; padding: 20rpx 0; border-top: 1rpx solid #ead6dd; border-bottom: 1rpx solid #ead6dd; }.metric { flex: 1; text-align: center; }.metric-number { color: #8f4761; font-size: 34rpx; font-weight: 900; }.metric-number text { margin-left: 3rpx; font-size: 20rpx; }.metric-label { margin-top: 4rpx; color: #7c6d72; font-size: 20rpx; }.metric-divider { width: 1rpx; height: 54rpx; background: #e1cbd3; }.fallback-field { align-items: center; justify-content: center; margin-top: 17rpx; color: #78686e; font-size: 20rpx; }.fallback-field input { width: 70rpx; height: 54rpx; margin: 0 8rpx; border-bottom: 2rpx solid #bb6d87; color: #873d56; font-size: 25rpx; font-weight: 800; text-align: center; }
.records-head { align-items: center; justify-content: space-between; margin-top: 30rpx; }.records-title { font-size: 29rpx; font-weight: 800; }.clear-records { margin: 0; padding: 10rpx; background: transparent; color: #a65370; font-size: 21rpx; }.records-card { margin-top: 12rpx; overflow: hidden; border: 1rpx solid #dce3e0; border-radius: 24rpx; background: #fff; }.record-row { align-items: center; min-height: 96rpx; padding: 17rpx 20rpx; }.record-row + .record-row { border-top: 1rpx solid #edf1ef; }.record-dot { flex: none; width: 16rpx; height: 16rpx; margin-right: 17rpx; border: 3rpx solid #bd8195; border-radius: 50%; }.record-dot--latest { background: #a65370; }.record-main { flex: 1; min-width: 0; }.record-date { font-size: 24rpx; font-weight: 750; }.record-duration { margin-top: 4rpx; color: #84908c; font-size: 20rpx; }.delete-record { margin: 0; padding: 12rpx; background: transparent; color: #9a6b7b; font-size: 20rpx; }.empty-history { margin-top: 22rpx; padding: 34rpx 24rpx; border: 2rpx dashed #d6ddda; border-radius: 23rpx; color: #89938f; font-size: 22rpx; text-align: center; }.medical-note { margin-top: 25rpx; padding: 20rpx 22rpx; border-radius: 20rpx; background: #fff7e9; color: #7d633d; font-size: 20rpx; line-height: 1.65; }
