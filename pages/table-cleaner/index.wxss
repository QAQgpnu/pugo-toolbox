.page-heading {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.heading-mark {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  background: #e8f7f4;
  color: #078c82;
  font-size: 30rpx;
  font-weight: 800;
}

.heading-title {
  color: #122129;
  font-size: 38rpx;
  font-weight: 800;
}

.field-label {
  color: #4a5a54;
  font-size: 24rpx;
  font-weight: 700;
}

.field-placeholder { color: #9aa6a1; }

.input-card {
  margin-top: 28rpx;
  padding: 24rpx;
}

.cleaner-input {
  width: 100%;
  height: 280rpx;
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #d7e0dd;
  border-radius: 16rpx;
  background: #fbfdfc;
  color: #122129;
  font-size: 26rpx;
  line-height: 1.5;
}

.input-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.input-counter {
  color: #8a9692;
  font-size: 21rpx;
}

.input-counter--warn { color: #b3403a; }

.cleaner-groups { margin-top: 26rpx; }

.cleaner-group { margin-top: 24rpx; }

.cleaner-group:first-child { margin-top: 0; }

.group-label {
  color: #4a5a54;
  font-size: 25rpx;
  font-weight: 750;
}

.columns-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid #d7e0dd;
  border-radius: 16rpx;
  background: #ffffff;
}

.columns-label {
  flex: none;
  color: #66756f;
  font-size: 23rpx;
}

.columns-input {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  color: #122129;
  font-size: 26rpx;
  text-align: right;
}

.operation-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 4rpx;
  margin-right: -8rpx;
  margin-left: -8rpx;
}

.operation-cell {
  width: 50%;
  min-width: 0;
  padding: 8rpx;
}

.operation-chip {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  padding: 14rpx 16rpx;
  border: 1rpx solid #d7e0dd;
  border-radius: 18rpx;
  background: #ffffff;
  transition: opacity 120ms ease;
}

.chip-pressed { opacity: 0.78; }

.operation-name {
  color: #122129;
  font-size: 25rpx;
  font-weight: 750;
}

.operation-hint {
  margin-top: 4rpx;
  color: #85918c;
  font-size: 20rpx;
  line-height: 1.4;
}

.result-card {
  margin-top: 28rpx;
  padding: 24rpx;
}

.result-head {
  display: flex;
  flex-direction: column;
}

.result-stats {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 8rpx;
  color: #8a9692;
  font-size: 21rpx;
}

.result-arrow { margin: 0 10rpx; }

.result-stats-strong {
  color: #0b5d56;
  font-weight: 750;
}

.cleaner-output {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #eef4f2;
  color: #122129;
  font-size: 25rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.result-actions {
  display: flex;
  flex-direction: row;
  margin-top: 20rpx;
  margin-right: -8rpx;
  margin-left: -8rpx;
}

.result-action {
  flex: 1;
  margin: 0 8rpx;
  min-height: 76rpx;
  font-size: 26rpx;
}

.result-action--disabled { opacity: 0.45; }

.button-pressed { opacity: 0.82; }

.privacy-note { margin-top: 30rpx; }
