.retire-page {
  padding-top: 42rpx;
  padding-bottom: 72rpx;
}

.feature-hero,
.section-head,
.input-shell,
.double-row,
.picker-shell,
.result-split,
.formula-row {
  display: flex;
  flex-direction: row;
}

.feature-hero {
  align-items: center;
}

.hero-mark {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-right: 22rpx;
  border-radius: 25rpx;
  background: #3e6f91;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 850;
  box-shadow: 0 12rpx 26rpx rgba(62, 111, 145, 0.2);
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 39rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 7rpx;
  color: #71807b;
  font-size: 23rpx;
  line-height: 1.45;
}

.scope-note {
  margin-top: 28rpx;
  padding: 21rpx 22rpx;
  border-radius: 21rpx;
  background: #edf5fa;
  color: #405f73;
}

.scope-title {
  font-size: 23rpx;
  font-weight: 800;
}

.scope-copy {
  margin-top: 7rpx;
  font-size: 21rpx;
  line-height: 1.6;
}

.section-head {
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-head .section-title {
  margin-bottom: 0;
}

.example-button {
  min-height: 60rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid #a6c4d8;
  border-radius: 999rpx;
  background: #ffffff;
  color: #3d6f90;
  font-size: 22rpx;
  font-weight: 700;
}

.form-panel {
  padding: 25rpx;
}

.field-block + .field-block,
.field-block + .double-row,
.double-row + .field-block {
  margin-top: 23rpx;
}

.field-title {
  margin-bottom: 7rpx;
  color: #3f4f4a;
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.4;
}

.field-help {
  margin-bottom: 10rpx;
  color: #82908b;
  font-size: 20rpx;
  line-height: 1.5;
}

.input-shell,
.picker-shell {
  align-items: center;
  width: 100%;
  min-height: 86rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d5dfdc;
  border-radius: 18rpx;
  background: #f9fbfa;
}

.picker-shell {
  justify-content: space-between;
  color: #17251f;
  font-size: 28rpx;
}

.number-input {
  flex: 1;
  min-width: 0;
  height: 82rpx;
  color: #17251f;
  font-size: 28rpx;
}

.input-unit {
  flex: none;
  margin-left: 9rpx;
  color: #72807b;
  font-size: 22rpx;
}

.half-field {
  flex: 1;
  min-width: 0;
}

.half-field--last {
  margin-left: 16rpx;
}

.calculate-button {
  min-height: 92rpx;
  margin-top: 27rpx;
  border-radius: 21rpx;
  background: #3e6f91;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 26rpx rgba(62, 111, 145, 0.18);
}

.result-section {
  margin-top: 30rpx;
}

.result-primary {
  padding: 30rpx 28rpx;
  border-radius: 27rpx 27rpx 0 0;
  background: #365f7b;
  color: #ffffff;
  text-align: center;
}

.result-label {
  font-size: 23rpx;
  opacity: 0.84;
}

.result-number {
  margin-top: 9rpx;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.2;
}

.result-caption {
  margin-top: 8rpx;
  font-size: 21rpx;
  opacity: 0.76;
}

.result-split {
  align-items: stretch;
  padding: 24rpx 10rpx;
  border-right: 1rpx solid #dce5e2;
  border-bottom: 1rpx solid #dce5e2;
  border-left: 1rpx solid #dce5e2;
  border-radius: 0 0 25rpx 25rpx;
  background: #ffffff;
}

.result-piece {
  flex: 1;
  min-width: 0;
  padding: 0 8rpx;
  text-align: center;
}

.piece-label {
  color: #687772;
  font-size: 21rpx;
}

.piece-value {
  margin-top: 7rpx;
  color: #335f7d;
  font-size: 29rpx;
  font-weight: 850;
}

.piece-note {
  margin-top: 7rpx;
  color: #8a9692;
  font-size: 18rpx;
  line-height: 1.45;
}

.piece-divider {
  width: 1rpx;
  margin: 4rpx 4rpx;
  background: #e2e8e6;
}

.formula-card {
  margin-top: 16rpx;
  padding: 23rpx;
}

.formula-title {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.formula-row {
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  color: #697873;
  font-size: 22rpx;
}

.formula-value {
  margin-left: 16rpx;
  color: #305d79;
  font-weight: 800;
}

.formula-copy {
  padding-top: 13rpx;
  border-top: 1rpx solid #edf1ef;
  color: #71807b;
  font-size: 20rpx;
  line-height: 1.6;
}

.formula-copy + .formula-copy {
  margin-top: 10rpx;
}

.clear-result {
  min-height: 68rpx;
  margin-top: 14rpx;
  background: transparent;
  color: #3e6f91;
  font-size: 23rpx;
  font-weight: 700;
}

.warning-note {
  margin-top: 30rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #fff5e6;
  color: #7f5c2d;
}

.warning-title {
  font-size: 23rpx;
  font-weight: 800;
}

.warning-copy {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.65;
}
