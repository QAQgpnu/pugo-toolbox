@import "../../styles/entertainment.wxss";

.woodfish-stage {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 580rpx;
}

.woodfish-ring {
  position: absolute;
  width: 480rpx;
  height: 480rpx;
  border: 3rpx solid #f1cca1;
  border-radius: 50%;
  opacity: 0.72;
  transition: transform 180ms ease, opacity 180ms ease;
}

.woodfish-ring--hit {
  opacity: 0.2;
  transform: scale(1.12);
}

.woodfish {
  position: relative;
  width: 360rpx;
  height: 278rpx;
  border-radius: 52% 45% 50% 46%;
  background: linear-gradient(145deg, #bd7127, #8e491f);
  box-shadow: inset -28rpx -32rpx 0 rgba(75, 30, 8, 0.16), 0 34rpx 70rpx rgba(104, 54, 22, 0.18);
  transition: transform 120ms ease;
}

.woodfish--hit { transform: scale(0.94) rotate(-1deg); }

.woodfish-mouth {
  position: absolute;
  left: 54rpx;
  top: 136rpx;
  width: 260rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #542814;
  transform: rotate(-4deg);
}

.woodfish-stick {
  position: absolute;
  z-index: 2;
  left: 168rpx;
  top: -92rpx;
  width: 32rpx;
  height: 198rpx;
  border-radius: 18rpx;
  background: #7f471f;
  transform: rotate(34deg);
  transform-origin: bottom;
}

.woodfish-feedback {
  position: absolute;
  z-index: 3;
  top: 54rpx;
  color: #dc8600;
  font-size: 31rpx;
  font-weight: 800;
  opacity: 0;
  transform: translateY(16rpx);
  transition: opacity 120ms ease, transform 180ms ease;
}

.woodfish-feedback--show { opacity: 1; transform: translateY(0); }
.woodfish-hint { margin-top: -26rpx; color: #71807b; font-size: 23rpx; text-align: center; }
.setting-list { margin-top: 34rpx; overflow: hidden; }
.setting-row { display: flex; flex-direction:row; align-items: center; justify-content: space-between; min-height: 116rpx; padding: 18rpx 24rpx; }
.setting-row + .setting-row { border-top: 1rpx solid #edf1ef; }
.setting-title { font-size: 28rpx; font-weight: 700; }
.setting-desc { margin-top: 5rpx; color: #71807b; font-size: 22rpx; }
