@import "../../styles/entertainment.wxss";

.timer-card { margin-top: 30rpx; padding: 42rpx 24rpx 38rpx; text-align: center; transition: border-color 180ms ease, box-shadow 180ms ease; }
.timer-card--active { border-color: #f0b5aa; box-shadow: 0 18rpx 50rpx rgba(223, 109, 91, 0.12); }
.timer-state { display: flex; flex-direction:row; align-items: center; justify-content: center; color: #71807b; font-size: 23rpx; font-weight: 650; }
.timer-card--active .timer-state { color: #d65f4e; }
.timer-dot { width: 12rpx; height: 12rpx; margin-right: 10rpx; border-radius: 50%; background: #b9c5c1; }
.timer-card--active .timer-dot { background: #df6d5b; box-shadow: 0 0 0 8rpx #fff0ed; }
.timer-clock { margin-top: 24rpx; color: #122129; font-size: 82rpx; font-weight: 850; letter-spacing: -3rpx; }
.timer-action { display: flex; flex-direction:row; align-items: center; justify-content: center; width: 210rpx; height: 210rpx; margin: 38rpx auto 0; border-radius: 50%; background: #078c82; color: #fff; font-size: 29rpx; font-weight: 800; box-shadow: 0 22rpx 46rpx rgba(7, 140, 130, 0.2); }
.timer-action--stop { background: #df6d5b; box-shadow: 0 22rpx 46rpx rgba(223, 109, 91, 0.24); }
.scene-list { display: flex; flex-direction: row; margin-top: 24rpx; margin-right: -6rpx; margin-left: -6rpx; }
.scene { flex: 1; margin: 0 6rpx; padding: 18rpx 4rpx; border: 1rpx solid #dce3e0; border-radius: 18rpx; background: #fff; color: #71807b; font-size: 22rpx; text-align: center; }
.scene--active { border-color: #efafa4; background: #fff0ed; color: #c95647; font-weight: 750; }
.undo { display: flex; flex-direction:row; align-items: center; justify-content: space-between; margin-top: 18rpx; padding: 18rpx 22rpx; border-radius: 18rpx; background: #fff7ef; color: #80664f; font-size: 22rpx; }
.undo-action { color: #b55a16; font-weight: 750; }
.stat-value-small { font-size: 31rpx; }
.week-chart { display: flex; flex-direction:row; align-items: flex-end; justify-content: space-between; height: 190rpx; margin-top: 16rpx; padding: 24rpx 30rpx 18rpx; }
.week-item { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.week-bar { width: 36rpx; min-height: 12rpx; border-radius: 12rpx 12rpx 5rpx 5rpx; background: #bfe6df; }
.week-bar--today { background: #ef9d90; }
.week-label { margin-top: 10rpx; color: #8a9692; font-size: 20rpx; }
