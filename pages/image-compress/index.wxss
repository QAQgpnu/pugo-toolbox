.media-page { padding-top: calc(42rpx + env(safe-area-inset-top)); padding-bottom: 64rpx; }
.media-hero { display: flex; flex-direction: row; align-items: center; }
.media-mark { display: flex; flex: none; flex-direction: row; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin-right: 22rpx; border-radius: 24rpx; background: #078c82; color: #fff; font-size: 30rpx; font-weight: 800; box-shadow: 0 12rpx 24rpx rgba(7,140,130,.16); }
.media-hero-copy { min-width: 0; }
.media-title { color: #122129; font-size: 40rpx; font-weight: 800; line-height: 1.2; }
.media-subtitle { margin-top: 6rpx; color: #71807b; font-size: 23rpx; line-height: 1.45; }
.privacy-strip { display: flex; flex-direction: row; align-items: center; margin-top: 28rpx; padding: 18rpx 20rpx; border-radius: 18rpx; background: #eaf7f5; color: #087c73; font-size: 22rpx; line-height: 1.5; }
.privacy-dot { flex: none; width: 12rpx; height: 12rpx; margin-right: 14rpx; border-radius: 50%; background: #078c82; }
.media-surface { overflow: hidden; margin-top: 24rpx; border: 1rpx solid #d8e1dd; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(18,33,41,.05); }
.choose-card { min-height: 310rpx; }
.choose-card--disabled { opacity: .76; }
.choose-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 310rpx; padding: 34rpx; }
.choose-plus { display: flex; flex-direction: row; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border: 2rpx dashed #80bdb7; border-radius: 28rpx; background: #eff9f7; color: #078c82; font-size: 44rpx; }
.choose-title { margin-top: 20rpx; color: #122129; font-size: 28rpx; font-weight: 750; }
.choose-hint { margin-top: 7rpx; color: #83908c; font-size: 22rpx; }
.source-preview { display: block; width: 100%; height: 330rpx; background: #edf2f0; }
.source-meta,.result-head,.result-actions,.option-row { display: flex; flex-direction: row; }
.source-meta { align-items: center; justify-content: space-between; padding: 20rpx 24rpx; }
.meta-title { font-size: 25rpx; font-weight: 750; }.meta-copy { margin-top: 3rpx; color: #87938f; font-size: 20rpx; }.meta-size { color: #078c82; font-size: 27rpx; font-weight: 800; }
.options-card { padding: 26rpx 24rpx; }
.option-label { color: #4f605a; font-size: 23rpx; font-weight: 700; }.option-label--spaced { margin-top: 24rpx; }
.option-row { flex-wrap: wrap; margin: 10rpx -6rpx -2rpx; }
.option-chip { flex: 1; min-width: 186rpx; min-height: 70rpx; margin: 6rpx; padding: 14rpx 12rpx; border: 1rpx solid #d6dfdb; border-radius: 18rpx; background: #f7f9f8; color: #65736e; font-size: 22rpx; font-weight: 650; }
.option-chip--active { border-color: #70bdb5; background: #e8f7f4; color: #067b72; }
.option-chip[disabled],.secondary-action[disabled],.primary-action[disabled] { opacity: .56; }
.media-primary { margin-top: 26rpx; min-height: 88rpx; border-radius: 21rpx; background: #078c82; color: #fff; font-size: 27rpx; font-weight: 750; }
.media-primary[disabled] { background: #a9c5c0; color: rgba(255,255,255,.9); }
.result-card { margin-top: 24rpx; padding: 18rpx; border: 2rpx solid #9acfc8; border-radius: 28rpx; background: #f3fbf9; }
.result-preview { display: block; width: 100%; height: 360rpx; border-radius: 20rpx; background: #e7efec; }
.result-head { align-items: center; justify-content: space-between; padding: 20rpx 8rpx 12rpx; }.result-kicker { color: #078c82; font-size: 25rpx; font-weight: 800; }.result-dimensions { margin-top: 4rpx; color: #788681; font-size: 21rpx; }.result-size { color: #122129; font-size: 32rpx; font-weight: 850; }
.saving-badge { margin: 2rpx 8rpx 16rpx; padding: 13rpx 16rpx; border-radius: 15rpx; background: #dff4ee; color: #05766d; font-size: 21rpx; text-align: center; }.saving-badge--neutral { background: #eef2f0; color: #65736f; }
.result-actions { margin: 0 2rpx 2rpx; }.secondary-action,.primary-action { flex: 1; min-height: 82rpx; border-radius: 19rpx; font-size: 24rpx; font-weight: 750; }.secondary-action { margin-right: 12rpx; border: 1rpx solid #86bdb7; background: #fff; color: #077a71; }.primary-action { background: #078c82; color: #fff; }
.media-note { padding: 24rpx 12rpx 0; color: #7d8a86; font-size: 21rpx; line-height: 1.65; }
.processor-canvas { position: fixed; top: 0; left: -10000px; opacity: 0; pointer-events: none; }
.card-pressed { opacity: .78; transform: scale(.985); }
