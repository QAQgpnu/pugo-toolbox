.privacy-page {
  padding-top: 34rpx;
}

.privacy-intro {
  padding: 42rpx 32rpx;
  border: 1rpx solid #c9e3de;
  border-radius: 26rpx;
  background: #eaf5f2;
  text-align: center;
}

.privacy-mark {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  margin: 0 auto 20rpx;
  border: 3rpx solid #078c82;
  border-radius: 24rpx 24rpx 30rpx 30rpx;
  color: #078c82;
  font-size: 23rpx;
  font-weight: 700;
}

.privacy-title {
  color: #122129;
  font-size: 34rpx;
  font-weight: 700;
}

.privacy-subtitle {
  margin-top: 12rpx;
  color: #65746f;
  font-size: 25rpx;
  line-height: 1.6;
}

.policy-card {
  padding: 0 28rpx;
}

.policy-item {
  padding: 28rpx 0;
}

.policy-item + .policy-item {
  border-top: 1rpx solid #e3e9e6;
}

.policy-name {
  color: #122129;
  font-size: 29rpx;
  font-weight: 600;
}

.policy-copy {
  margin-top: 10rpx;
  color: #65746f;
  font-size: 25rpx;
  line-height: 1.7;
}

.notice-card {
  margin-top: 38rpx;
  padding: 28rpx;
  border-left: 6rpx solid #dc8600;
  border-radius: 0 20rpx 20rpx 0;
  background: #fff6e8;
  color: #695331;
  font-size: 25rpx;
  line-height: 1.7;
}

.notice-title {
  margin-bottom: 6rpx;
  color: #9a5a00;
  font-weight: 700;
}
