.run-page {
  padding-top: calc(42rpx + env(safe-area-inset-top));
}

.run-heading {
  text-align: center;
}

.run-kicker {
  color: #078c82;
  font-size: 23rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.run-title {
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 900;
}

.run-progress-copy {
  margin-top: 10rpx;
  color: #687671;
  font-size: 27rpx;
}

.progress-track {
  height: 18rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #dce5e1;
}

.progress-value {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #079b90, #0aba8d);
  transition: width 180ms ease;
}

.important-notice {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #f0c47b;
  border-radius: 18rpx;
  background: #fff8e9;
  color: #835313;
  font-size: 24rpx;
  line-height: 1.5;
}

.notice-mark {
  display: flex;
  flex-direction: row;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #c86f00;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}

.check-list {
  margin-top: 24rpx;
}

.check-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 108rpx;
  margin-bottom: 14rpx;
  padding: 20rpx;
  border: 2rpx solid #d6dfdb;
  border-radius: 22rpx;
  background: #ffffff;
}

.check-item--critical {
  border-left: 8rpx solid #c86f00;
}

.check-item--checked {
  border-color: #81c3bc;
  background: #eaf7f5;
}

.check-item--checked.check-item--critical {
  border-left-color: #078c82;
}

.check-box {
  display: flex;
  flex-direction: row;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-right: 16rpx;
  border: 3rpx solid #9aa8a3;
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 900;
}

.check-item--checked .check-box {
  border-color: #078c82;
  background: #078c82;
}

.check-label {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.critical-label {
  margin-left: 10rpx;
  padding: 6rpx 9rpx;
  border-radius: 9rpx;
  background: #fff0d8;
  color: #b96500;
  font-size: 19rpx;
  font-weight: 800;
}

.confirm-copy {
  flex: none;
  margin-left: 12rpx;
  color: #078c82;
  font-size: 22rpx;
  font-weight: 800;
}

.unfinished-banner,
.ready-banner {
  margin-top: 8rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f2f5f4;
  color: #66746f;
  font-size: 23rpx;
  line-height: 1.55;
  text-align: center;
}

.ready-banner {
  background: #e5f5f2;
  color: #067a71;
  font-weight: 700;
}

.complete-button {
  margin-top: 18rpx;
}

.safety-boundary {
  margin-top: 18rpx;
  color: #7a8782;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}

.completion {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: calc(100vh - 160rpx);
  padding-top: 60rpx;
  text-align: center;
}

.completion-icon {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #078c82;
  color: #ffffff;
  font-size: 76rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 42rpx rgba(7, 140, 130, 0.24);
}

.completion-title {
  margin-top: 30rpx;
  font-size: 44rpx;
  font-weight: 900;
}

.completion-list {
  margin-top: 18rpx;
  color: #078c82;
  font-size: 32rpx;
  font-weight: 800;
}

.completion-count {
  margin-top: 8rpx;
  color: #56645f;
  font-size: 27rpx;
}

.completion-time {
  margin-top: 16rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #edf2f0;
  color: #50605a;
  font-size: 25rpx;
  font-weight: 700;
}

.completion-note {
  margin-top: 34rpx;
  color: #71807b;
  font-size: 23rpx;
  line-height: 1.65;
}

.back-button {
  margin-top: 34rpx;
}
