.drawer-layer,
.drawer-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.drawer-layer { z-index: 90; }

.drawer-mask {
  z-index: 91;
  background: rgba(15, 27, 31, 0.48);
  animation: mask-in 160ms ease-out;
}

.tool-drawer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 92;
  max-height: 86vh;
  padding: 12rpx 24rpx env(safe-area-inset-bottom);
  border-radius: 36rpx 36rpx 0 0;
  background: #f8faf9;
  box-shadow: 0 -18rpx 50rpx rgba(18, 33, 41, 0.18);
  animation: drawer-in 190ms ease-out;
}

.drawer-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #ccd6d2;
}

.drawer-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.drawer-title {
  color: #122129;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}

.drawer-subtitle {
  margin-top: 4rpx;
  color: #7a8782;
  font-size: 22rpx;
}

.drawer-close,
.drawer-search-clear {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  color: #687772;
}

.drawer-close {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #edf2f0;
  font-size: 42rpx;
}

.drawer-search {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 84rpx;
  margin-top: 22rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d7e0dd;
  border-radius: 22rpx;
  background: #ffffff;
}

.drawer-search-icon {
  position: relative;
  flex: none;
  width: 25rpx;
  height: 25rpx;
  margin-right: 18rpx;
  border: 4rpx solid #7f8c87;
  border-radius: 50%;
}

.drawer-search-icon::after {
  position: absolute;
  right: -10rpx;
  bottom: -7rpx;
  width: 13rpx;
  border-top: 4rpx solid #7f8c87;
  content: '';
  transform: rotate(45deg);
}

.drawer-search-input {
  flex: 1;
  height: 80rpx;
  color: #122129;
  font-size: 27rpx;
}

.drawer-search-placeholder { color: #98a39f; }

.drawer-search-clear {
  width: 58rpx;
  height: 58rpx;
  margin-left: 8rpx;
  font-size: 34rpx;
}

.category-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.category-strip {
  display: inline-flex;
  flex-direction: row;
  padding-right: 24rpx;
}

.category-chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 62rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid #d4ddda;
  border-radius: 999rpx;
  background: #ffffff;
  color: #66756f;
  font-size: 23rpx;
  font-weight: 650;
}

.category-chip + .category-chip { margin-left: 12rpx; }

.category-chip--active {
  border-color: #078c82;
  background: #078c82;
  color: #ffffff;
}

.category-chip-count {
  margin-left: 8rpx;
  opacity: 0.72;
  font-size: 19rpx;
}

.tool-scroll {
  height: 49vh;
  margin-top: 18rpx;
}

.drawer-tool-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-right: -7rpx;
  margin-left: -7rpx;
  padding-bottom: 8rpx;
}

.drawer-tool-cell {
  width: 25%;
  min-width: 0;
  padding: 0 7rpx 14rpx;
}

.drawer-tool-entry {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-height: 174rpx;
  padding: 20rpx 8rpx 14rpx;
  border: 1rpx solid #dce4e1;
  border-radius: 22rpx;
  background: #ffffff;
  transition: opacity 120ms ease, transform 120ms ease;
}

.drawer-tool-entry--pressed {
  opacity: 0.78;
  transform: scale(0.965);
}

.drawer-favorite {
  position: absolute;
  top: 3rpx;
  right: 3rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  color: #a3ada9;
  font-size: 31rpx;
}

.drawer-favorite--active { color: #dc8600; }

.drawer-tool-symbol {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
  background: #e8f7f4;
  color: #078c82;
  font-size: 23rpx;
  font-weight: 800;
}

.drawer-tool-symbol--memory { background: #e8f7f4; color: #078c82; }
.drawer-tool-symbol--life { background: #eef3ff; color: #4e6fa8; }
.drawer-tool-symbol--image { background: #edf4ff; color: #377db7; }
.drawer-tool-symbol--office { background: #fff4df; color: #ae6900; }
.drawer-tool-symbol--fun { background: #f2edff; color: #7857b3; }
.drawer-tool-symbol--women { background: #fff0f4; color: #a65370; }
.drawer-tool-symbol--men { background: #e8f2fa; color: #286fa9; }

.drawer-tool-name,
.drawer-tool-desc {
  width: 100%;
  overflow: hidden;
  line-height: 1.35;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drawer-tool-name {
  margin-top: 10rpx;
  color: #1d2d33;
  font-size: 21rpx;
  font-weight: 750;
}

.drawer-tool-desc {
  margin-top: 3rpx;
  color: #85918c;
  font-size: 18rpx;
}

.drawer-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 330rpx;
  color: #71807b;
  text-align: center;
}

.drawer-empty-mark {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border: 3rpx solid #9bb0aa;
  border-radius: 50%;
  font-weight: 800;
}

.drawer-empty-title {
  margin-top: 18rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.drawer-empty-desc {
  margin-top: 6rpx;
  color: #929e99;
  font-size: 22rpx;
}

.drawer-privacy {
  padding: 10rpx 0 14rpx;
  color: #98a39f;
  font-size: 19rpx;
  text-align: center;
}

.bottom-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 70;
  display: flex;
  flex-direction: row;
  min-height: 112rpx;
  padding: 8rpx 18rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid #dfe5e2;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 26rpx rgba(18, 33, 41, 0.05);
}

.nav-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 94rpx;
  color: #74817d;
  font-size: 21rpx;
}

.nav-item--active {
  color: #078c82;
  font-weight: 700;
}

.nav-label { margin-top: 5rpx; }

.home-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  border-radius: 0 0 6rpx 6rpx;
}

.home-icon::before {
  position: absolute;
  top: -8rpx;
  left: 4rpx;
  width: 24rpx;
  height: 24rpx;
  border-top: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  content: '';
  transform: rotate(45deg);
}

.nav-item--create {
  position: relative;
  justify-content: flex-end;
  color: #078c82;
}

.create-button {
  position: absolute;
  top: -34rpx;
  left: 50%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 94rpx;
  height: 94rpx;
  border: 8rpx solid #ffffff;
  border-radius: 50%;
  background: #078c82;
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(7, 140, 130, 0.3);
  transform: translateX(-50%);
}

.create-symbol {
  margin-top: -4rpx;
  font-size: 60rpx;
  font-weight: 300;
  line-height: 1;
}

.create-label {
  margin-bottom: 4rpx;
  font-size: 21rpx;
  font-weight: 750;
}

.settings-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.settings-icon::before,
.settings-icon::after {
  position: absolute;
  top: 14rpx;
  left: -8rpx;
  width: 46rpx;
  border-top: 4rpx solid currentColor;
  content: '';
}

.settings-icon::before { transform: rotate(45deg); }
.settings-icon::after { transform: rotate(-45deg); }

.settings-core {
  position: absolute;
  top: 9rpx;
  left: 9rpx;
  width: 12rpx;
  height: 12rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  background: #ffffff;
}

@keyframes mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes drawer-in {
  from { transform: translateY(24rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
